# Where lingo listens.
HOST=127.0.0.1
PORT=8790
# The SQLite file.
LINGO_DB=lingo.db
# Supported languages (BCP 47); the source language of the apps' texts.
LINGO_LANGS=en,zh-Hans,zh-Hant,ja
LINGO_SOURCE_LANG=en
# Any OpenAI-compatible endpoint (…/v1) and its key: OpenAI, OpenRouter, Ollama (http://127.0.0.1:11434/v1), a gateway.
LINGO_LLM_URL=https://api.openai.com/v1
LINGO_LLM_KEY=
# The model for texts asked for at run time, and for catalogs built ahead of time (defaults to the first).
LINGO_MODEL=gpt-4o-mini
LINGO_CATALOG_MODEL=
# json_schema, json_object, or empty (the JSON is read from the answer's text; works everywhere).
LINGO_RESPONSE_FORMAT=
LINGO_LLM_TIMEOUT_MS=60000
# A JSON array of global glossary entries, loaded at start-up: [{"term": "…", "rule": "keep"}].
LINGO_GLOSSARY=
# The admin pages (review, correct, glossary) on a port of their own, and their token. Put them behind
# your own login (a proxy that adds "Authorization: Bearer <token>"), or open them once with ?token=.
LINGO_ADMIN_PORT=
LINGO_ADMIN_TOKEN=
# Bearer for /ops/* (health, metrics, manifest, tools, actions); empty: those answer 404.
OPS_TOKEN=
# For /ops/manifest: the name of the monitored app that serves the model, if it is one;
# the host service that runs lingo (a systemd unit, a launchd label), for the monitor to watch.
LINGO_LLM_APP=
LINGO_SERVICE=
